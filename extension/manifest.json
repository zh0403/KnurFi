{
    "manifest_version": 3,
    "name": "KnurFi",
    "version": "1.0",
    "description": "Context layer for on-chain finance with encrypted notes.",

  "icons": {
    "16": "logo_512px.png",
    "48": "logo_512px.png",
    "128": "logo_512px.png"
  },

  "action": {
      "default_popup": "popup.html",
      "default_icon": "logo_512px.png"
  },

    "content_scripts": [
      {
        "matches": ["https://sepolia.etherscan.io/tx/*", "https://testnet.arcscan.app/tx/*"],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ],
    
    "permissions": ["storage"],
    "host_permissions": ["https://sepolia.etherscan.io/*", "https://testnet.arcscan.app/*"],
  "web_accessible_resources": [
    {
      "resources": ["ethers.js", "crypto-js.js", "abi.js", "inpage.js", "logo_512px.png"],
      "matches": ["<all_urls>"]
    }
  ]
  }